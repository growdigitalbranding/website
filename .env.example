# Make.com webhook that receives lead form submissions.
# Make > Scenarios > your scenario > Custom webhook > Copy address to clipboard.
#
# Optional fallback. The webhook URL is normally set in the dashboard under
# /admin/settings, which is stored in the database and takes precedence. This
# env var is used only when no URL has been saved there.
#
# Payload posted on each submission:
#   { name, whatsapp, project, source, submittedAt }
#   source is "homepage" or "contact-page"; submittedAt is an ISO timestamp.
MAKE_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Supabase — lead storage and the admin dashboard at /admin
# Project Settings > API in the Supabase dashboard.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses row level security, so it must never be given a
# NEXT_PUBLIC_ prefix or referenced from a client component. Used solely by the
# lead intake route, which has to write a lead for a visitor who is not
# signed in.
SUPABASE_SERVICE_ROLE_KEY=
